{
  "name": "react-router-dom-animate",
  "version": "1.2.1",
  "description": "Route transitions and KeepAlive caching for React Router",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "**/*.css",
    "dist/index.js",
    "dist/index.cjs"
  ],
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react-router",
    "route-transition",
    "keep-alive",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/ws18250840411/react-router-dom-animate.git"
  },
  "homepage": "https://gitee.com/ws18250840411/react-router-dom-animate",
  "bugs": {
    "url": "https://gitee.com/ws18250840411/react-router-dom-animate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run demo:build",
    "prepublishOnly": "npm run check && npm run build",
    "demo": "npm run build && npm run dev --prefix demo",
    "demo:src": "npm run dev:src --prefix demo",
    "demo:build": "npm run build --prefix demo",
    "e2e": "npm run e2e --prefix demo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0",
    "react-router-dom": ">=7.0.0 <8.0.0"
  },
  "dependencies": {
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "jsdom": "^26.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
